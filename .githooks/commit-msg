#!/bin/sh

commit_msg_file="$1"
first_line="$(sed -n '1p' "$commit_msg_file")"

pattern='^(feat|fix|docs|test|refactor|chore)\(zg-[0-9]{4}\): .+'

if echo "$first_line" | grep -Eq "$pattern"; then
	exit 0
fi

cat <<'EOF'
Invalid commit message format.

Expected:
  <type>(<ticket-id>): <message>

Example:
  feat(zg-0001): add config loader

Allowed types:
  feat, fix, docs, test, refactor, chore

Ticket ID is mandatory and must start with zg- followed by exactly 4 numbers:
  zg-0001
EOF

exit 1
